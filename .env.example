DEBUG=True
SECRET_KEY=change-this-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Render provides DATABASE_URL for its PostgreSQL database. Use DB_* locally.
DATABASE_URL=

# Product images use Cloudinary when configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, set CLOUDINARY_URL instead of the three values above.
CLOUDINARY_URL=

DB_NAME=ecommerce_ms
DB_USER=postgres
DB_PASSWORD=postgresql
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=officermdm@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=officermdm@gmail.com
# Render blocks Gmail SMTP. Deploy scripts/gmail_bridge.gs as a web app
# (execute as you, access: anyone), then set EMAIL_HTTP_URL to its /exec URL.
EMAIL_HTTP_URL=
# Must exactly match the Apps Script project property named SECRET.
EMAIL_HTTP_SECRET=

WHATSAPP_NUMBER=923002803733
SHIPPING_FLAT_RATE=150.00
TAX_PERCENT=0.00
CURRENCY=PKR
# False = coupon cannot stack on a line that already has a product offer.
ALLOW_COUPON_WITH_PRODUCT_OFFER=False
